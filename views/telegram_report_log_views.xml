<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="telegram_report_log_view_tree" model="ir.ui.view">
        <field name="name">telegram.report.log.tree</field>
        <field name="model">telegram.report.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" decoration-danger="state == 'error'">
                <field name="create_date"/>
                <field name="bot_id"/>
                <field name="kind"/>
                <field name="state"/>
                <field name="chat_id"/>
                <field name="command"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <record id="telegram_report_log_view_search" model="ir.ui.view">
        <field name="name">telegram.report.log.search</field>
        <field name="model">telegram.report.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="chat_id"/>
                <field name="command"/>
                <filter name="errors" string="Errores" domain="[('state', '=', 'error')]"/>
                <filter name="rejected" string="Chats rechazados" domain="[('kind', '=', 'rejected')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_bot" string="Bot" context="{'group_by': 'bot_id'}"/>
                    <filter name="group_kind" string="Tipo" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="telegram_report_log_action" model="ir.actions.act_window">
        <field name="name">Registros</field>
        <field name="res_model">telegram.report.log</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
